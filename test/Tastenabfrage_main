#include <Arduino.h>

constexpr uint8_t DATA_PIN  = 19;  // linker IC Pin 9
constexpr uint8_t CLOCK_PIN = 18;  // IC Pin 15
constexpr uint8_t LOAD_PIN  = 5;   // IC Pin 1

void setup() {
  Serial.begin(115200);

  pinMode(DATA_PIN, INPUT);
  pinMode(CLOCK_PIN, OUTPUT);
  pinMode(LOAD_PIN, OUTPUT);

  digitalWrite(CLOCK_PIN, LOW);
  digitalWrite(LOAD_PIN, HIGH);

  Serial.println();
  Serial.println("74HC165 Test: LOAD=Pin1, CLOCK/CE=Pin15, DATA=Pin9");
}

uint16_t read165() {
  uint16_t value = 0;

  // LOAD: parallele Eingänge übernehmen
  digitalWrite(LOAD_PIN, LOW);
  delayMicroseconds(20);
  digitalWrite(LOAD_PIN, HIGH);
  delayMicroseconds(20);

  for (int i = 0; i < 16; i++) {
    value <<= 1;

    if (digitalRead(DATA_PIN)) {
      value |= 1;
    }

    // Test-Puls auf Pin 15
    digitalWrite(CLOCK_PIN, HIGH);
    delayMicroseconds(20);
    digitalWrite(CLOCK_PIN, LOW);
    delayMicroseconds(20);
  }

  return value;
}

void loop() {
  uint16_t bits = read165();

  Serial.print("Bits: ");
  for (int i = 15; i >= 0; i--) {
    Serial.print((bits >> i) & 1);
  }

  Serial.print("  HEX: 0x");
  if (bits < 0x1000) Serial.print("0");
  if (bits < 0x0100) Serial.print("0");
  if (bits < 0x0010) Serial.print("0");
  Serial.println(bits, HEX);

  delay(300);
}