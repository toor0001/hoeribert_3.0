#include <Arduino.h>
#include <IRremote.hpp>

// ========================================
// 74HC165 Tastenplatine
// ========================================

constexpr uint8_t DATA_PIN  = 19;  // linker IC Pin 9
constexpr uint8_t CLOCK_PIN = 18;  // Pin 15
constexpr uint8_t LOAD_PIN  = 5;   // Pin 1

// ========================================
// IR Empfänger
// ========================================

constexpr uint8_t IR_PIN = 27;

// ========================================
// Lautstärkeregler
// ========================================

constexpr uint8_t VOL_PIN = 34;

// ========================================
// Button-Masken
// ========================================

#define BTN_A 0x0200
#define BTN_B 0x0100
#define BTN_C 0x0008
#define BTN_D 0x0004
#define BTN_E 0x0002
#define BTN_F 0x0010
#define BTN_G 0x0400
#define BTN_H 0x0020
#define BTN_I 0x0080
#define BTN_J 0x0040
#define BTN_K 0x4000
#define BTN_L 0x2000
#define BTN_M 0x1000
#define BTN_N 0x8000

struct ButtonMap {
  const char* name;
  uint16_t mask;
};

ButtonMap buttons[] = {
  {"A", BTN_A},
  {"B", BTN_B},
  {"C", BTN_C},
  {"D", BTN_D},
  {"E", BTN_E},
  {"F", BTN_F},
  {"G", BTN_G},
  {"H", BTN_H},
  {"I", BTN_I},
  {"J", BTN_J},
  {"K", BTN_K},
  {"L", BTN_L},
  {"M", BTN_M},
  {"N", BTN_N},
};

constexpr int BUTTON_COUNT =
  sizeof(buttons) / sizeof(buttons[0]);

uint16_t lastButtons = 0;
int lastVolume = -1;

// ========================================
// 74HC165 lesen
// ========================================

uint16_t read165() {

  uint16_t value = 0;

  // LOAD
  digitalWrite(LOAD_PIN, LOW);
  delayMicroseconds(20);

  digitalWrite(LOAD_PIN, HIGH);
  delayMicroseconds(20);

  // 16 Bit lesen
  for (int i = 0; i < 16; i++) {

    value <<= 1;

    if (digitalRead(DATA_PIN)) {
      value |= 1;
    }

    // CLOCK über Pin15
    digitalWrite(CLOCK_PIN, HIGH);
    delayMicroseconds(20);

    digitalWrite(CLOCK_PIN, LOW);
    delayMicroseconds(20);
  }

  return value;
}

// ========================================
// Lautstärke
// ========================================

int readAverageRaw() {

  long sum = 0;

  constexpr int SAMPLES = 8;

  for (int i = 0; i < SAMPLES; i++) {
    sum += analogRead(VOL_PIN);
    delayMicroseconds(500);
  }

  return sum / SAMPLES;
}

int rawToVolume(int raw) {

  constexpr int RAW_MIN = 0;
  constexpr int RAW_MAX = 4095;

  raw = constrain(raw, RAW_MIN, RAW_MAX);

  int volume = map(raw, RAW_MIN, RAW_MAX, 0, 30);

  return constrain(volume, 0, 30);
}

// ========================================
// Button-Ausgabe
// ========================================

void handleButtons() {

  uint16_t current = read165();

  uint16_t newlyPressed = current & ~lastButtons;

  if (newlyPressed != 0) {

    Serial.print("[BUTTON] ");

    bool first = true;

    for (int i = 0; i < BUTTON_COUNT; i++) {

      if (newlyPressed & buttons[i].mask) {

        if (!first) Serial.print(", ");

        Serial.print(buttons[i].name);

        first = false;
      }
    }

    Serial.println();
  }

  lastButtons = current;
}

// ========================================
// IR-Ausgabe
// ========================================

void handleIR() {

  if (IrReceiver.decode()) {

    Serial.println("[IR]");

    Serial.print("Protokoll: ");
    Serial.println(getProtocolString(IrReceiver.decodedIRData.protocol));

    Serial.print("Command: 0x");
    Serial.println(IrReceiver.decodedIRData.command, HEX);

    Serial.print("Raw: 0x");
    Serial.println(IrReceiver.decodedIRData.decodedRawData, HEX);

    Serial.println();

    IrReceiver.resume();
  }
}

// ========================================
// Lautstärke-Ausgabe
// ========================================

void handleVolume() {

  int raw = readAverageRaw();

  int volume = rawToVolume(raw);

  if (volume != lastVolume) {

    lastVolume = volume;

    Serial.print("[VOLUME] ");

    Serial.print(volume);
    Serial.print("/30");

    Serial.print("  RAW=");
    Serial.println(raw);
  }
}

// ========================================
// SETUP
// ========================================

void setup() {

  Serial.begin(115200);

  // 74HC165
  pinMode(DATA_PIN, INPUT);
  pinMode(CLOCK_PIN, OUTPUT);
  pinMode(LOAD_PIN, OUTPUT);

  digitalWrite(CLOCK_PIN, LOW);
  digitalWrite(LOAD_PIN, HIGH);

  // ADC
  analogReadResolution(12);
  analogSetPinAttenuation(VOL_PIN, ADC_11db);

  // IR
  IrReceiver.begin(IR_PIN, ENABLE_LED_FEEDBACK);

  Serial.println();
  Serial.println("====================================");
  Serial.println(" NOXON COMPLETE FRONTPANEL TEST");
  Serial.println("====================================");
  Serial.println();
}

// ========================================
// LOOP
// ========================================

void loop() {

  handleButtons();

  handleIR();

  handleVolume();

  delay(20);
}