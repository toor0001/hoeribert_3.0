#include <Arduino.h>

constexpr uint8_t DATA_PIN  = 19;  // linker IC Pin 9
constexpr uint8_t CLOCK_PIN = 18;  // Pin 15
constexpr uint8_t LOAD_PIN  = 5;   // Pin 1

const char* buttonNames[] = {
  "A","B","C","D","E","F","G",
  "H","I","J","K","L","M","N"
};

constexpr int BUTTON_COUNT =
  sizeof(buttonNames) / sizeof(buttonNames[0]);

uint16_t read165() {

  uint16_t value = 0;

  // LOAD
  digitalWrite(LOAD_PIN, LOW);
  delayMicroseconds(20);

  digitalWrite(LOAD_PIN, HIGH);
  delayMicroseconds(20);

  // 16 Bit lesen
  for (int i = 0; i < 16; i++) {

    value <<= 1;

    if (digitalRead(DATA_PIN)) {
      value |= 1;
    }

    // "Clock" auf Pin 15
    digitalWrite(CLOCK_PIN, HIGH);
    delayMicroseconds(20);

    digitalWrite(CLOCK_PIN, LOW);
    delayMicroseconds(20);
  }

  return value;
}

void waitForRelease() {

  while (read165() != 0) {
    delay(20);
  }
}

void printHex16(uint16_t value) {

  if (value < 0x1000) Serial.print("0");
  if (value < 0x0100) Serial.print("0");
  if (value < 0x0010) Serial.print("0");

  Serial.print(value, HEX);
}

void setup() {

  Serial.begin(115200);

  pinMode(DATA_PIN, INPUT);
  pinMode(CLOCK_PIN, OUTPUT);
  pinMode(LOAD_PIN, OUTPUT);

  digitalWrite(CLOCK_PIN, LOW);
  digitalWrite(LOAD_PIN, HIGH);

  Serial.println();
  Serial.println("================================");
  Serial.println("     74HC165 BUTTON MAPPER");
  Serial.println("================================");
  Serial.println();

  delay(2000);

  uint16_t mapping[BUTTON_COUNT];

  for (int i = 0; i < BUTTON_COUNT; i++) {

    Serial.println("--------------------------------");

    Serial.print("Bitte Taste ");
    Serial.print(buttonNames[i]);
    Serial.println(" druecken...");

    uint16_t value = 0;

    // warten bis Taste gedrückt
    while (value == 0) {
      value = read165();
      delay(20);
    }

    mapping[i] = value;

    Serial.print("Erkannt: 0x");
    printHex16(value);
    Serial.println();

    Serial.println("Taste loslassen...");

    waitForRelease();

    delay(500);
  }

  Serial.println();
  Serial.println("================================");
  Serial.println("        FINALE LISTE");
  Serial.println("================================");
  Serial.println();

  for (int i = 0; i < BUTTON_COUNT; i++) {

    Serial.print(buttonNames[i]);
    Serial.print(" = 0x");

    printHex16(mapping[i]);

    Serial.println();
  }

  Serial.println();
  Serial.println("Fertig.");
}

void loop() {
}